COMPOSE_PROJECT_NAME=vpn_admin_panel

# appliance mode: safe | full | behind-ingress
DEPLOY_MODE=safe

# provider: xray | wg | avg | mock
APP_PROVIDER=xray
PROVIDERS_ENABLED=xray,wg,avg,mock

DATABASE_URL=sqlite:///./data/data.db
API_TOKEN=admin-token

# auth baseline
AUTH_ENABLED=true
AUTH_COOKIE_NAME=vpn_admin_session
AUTH_SESSION_TTL_HOURS=24
AUTH_COOKIE_SECURE=false
ADMIN_USERNAME=admin
# recommended: generate with ./scripts/hash-password.sh and set hash
ADMIN_PASSWORD_HASH=
# fallback for bootstrap/dev only
ADMIN_PASSWORD=admin123

# runtime profile defaults (deploy.sh rewrites these by mode)
APP_ENV=production
DEV_ROLE_EMULATION=false
SCHEMA_MANAGEMENT_MODE=alembic

# ingress and compatibility settings
DOMAIN=
ENABLE_TLS_PROXY=false

# keep false when host already uses 443 dataplane; enable only when needed
ENABLE_XRAY_PUBLIC=false
XRAY_PUBLIC_PORT=8443
ENABLE_WG_RUNTIME=true
WG_PUBLIC_PORT=51820
ENABLE_AVG_RUNTIME=true

# frontend build vars
VITE_API_URL=
# optional token fallback (leave empty for cookie auth)
VITE_API_TOKEN=
