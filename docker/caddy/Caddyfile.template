{$SITE_ADDR} {
    encode gzip

    @api path /api/*
    handle @api {
        reverse_proxy api:8000
    }

    @sse path /api/events/stream*
    handle @sse {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:4173
    }

    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer-when-downgrade
    }
}
